{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 18,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "base-defaults",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/out/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang-cl.exe",
                "CMAKE_CXX_COMPILER": "clang-cl.exe",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "BUILD_DOCS": "OFF",
                "BUILD_EXAMPLES": "OFF"
            }
        },
        {
            "name": "dev-debug",
            "displayName": "Development Debug",
            "description": "Debug build with tests and sanitizers enabled",
            "inherits": "base-defaults",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug",
                "BUILD_TESTS": "ON",
                "ENABLE_ASAN": "ON",
                "ENABLE_USAN": "ON"
            }
        },
        {
            "name": "prod-release",
            "displayName": "Production Release",
            "description": "Optimized release build for deployment",
            "inherits": "base-defaults",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "BUILD_TESTS": "OFF",
                "ENABLE_ASAN": "OFF",
                "ENABLE_USAN": "OFF",
                "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG"
            }
        },
        {
            "name": "ci-analysis",
            "displayName": "CI Static Analysis",
            "description": "Build for CI pipeline with strict checks",
            "inherits": "prod-release",
            "cacheVariables": {
                "BUILD_TESTS": "ON",
                "ENABLE_CPPCHECK": "ON"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "dev-build",
            "displayName": "Build Debug",
            "configurePreset": "dev-debug",
            "jobs": 4
        },
        {
            "name": "prod-build",
            "displayName": "Build Release",
            "configurePreset": "prod-release",
            "jobs": 4
        }
    ],
    "testPresets": [
        {
            "name": "dev-test",
            "displayName": "Run Tests",
            "configurePreset": "dev-debug",
            "output": {
                "outputOnFailure": true
            },
            "execution": {
                "noTestsAction": "error",
                "stopOnFailure": true
            }
        }
    ]
}
